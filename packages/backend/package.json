{
  "name": "@ptv-discovery-coach/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --build",
    "start": "tsx src/server.ts",
    "start:node": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "graph:init": "tsx src/graph/scripts/initGraph.ts",
    "graph:seed": "tsx src/graph/scripts/seedGraph.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:flatbed": "tsx src/db/seed-flatbed-templates.ts"
  },
  "dependencies": {
    "@azure/search-documents": "^13.0.0",
    "@deepgram/sdk": "^5.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@ptv-discovery-coach/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.1",
    "microsoft-cognitiveservices-speech-sdk": "1.42.0",
    "neo4j-driver": "^5.27.0",
    "onnxruntime-node": "^1.19.0",
    "pdfkit": "0.15.2",
    "postgres": "^3.4.9",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pdfkit": "0.13.9",
    "@types/ws": "^8.5.10",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^3.20.0",
    "vitest": "^1.6.0"
  }
