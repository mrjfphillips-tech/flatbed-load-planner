# Server configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# JWT signing secret — REQUIRED. Use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET="change-me-use-openssl-rand-hex-32"

# CORS origin (set to specific origins in production, or 'true' for all origins in dev)
CORS_ORIGIN=true

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ptv_discovery_coach"

# PostgreSQL connection (used by drizzle-kit when DATABASE_URL not set)
DB_HOST="localhost"
DB_PORT=5432
DB_USER="ptv_coach"
DB_PASSWORD="ptv_coach_dev"
DB_NAME="ptv_discovery_coach"

# Neo4j connection
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="ptv_coach_dev"

# Redis URL (for caching and pub/sub)
REDIS_URL="redis://localhost:6379"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# OpenAI API key (for GPT-4o and Whisper)
OPENAI_API_KEY="sk-..."

# Azure Speech Services
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# Cross-Encoder Model (ms-marco-MiniLM-L-12-v2 ONNX)
CROSS_ENCODER_MODEL_PATH="./models/ms-marco-MiniLM-L-12-v2.onnx"
