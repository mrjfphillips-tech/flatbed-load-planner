# Server configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# JWT signing secret — REQUIRED. Use: openssl rand -hex 32
JWT_SECRET="change-me-use-openssl-rand-hex-32"

# CORS origin (set to specific origins in production)
CORS_ORIGIN=true

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/optiflow_load_planner"
