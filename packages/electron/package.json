{
  "name": "@ptv-discovery-coach/electron",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=../frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && electron-builder",
    "build:dir": "tsc && electron-builder --dir",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "fast-check": "^3.20.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  }
}
