        { "code": "M", "name": "Metrics", "icon": "chart-analytics", "color": "#1e3a5f", "questions": ["What measurable outcomes matter?", "Cost per stop, fleet utilization, OTIF, planning labor, empty miles, CO2 objectives"] },
        { "code": "E", "name": "Economic Buyer", "icon": "money-euro", "color": "#1e3a5f", "questions": ["Who owns the budget?", "Operations, IT, Finance, Supply Chain, Procurement?"] },
        { "code": "D", "name": "Decision Criteria", "icon": "checklist", "color": "#1e3a5f", "questions": ["How will they evaluate success?", "Business criteria vs. operational criteria"] },
        { "code": "D", "name": "Decision Process", "icon": "workflow-process", "color": "#1e3a5f", "questions": ["Evaluation timeline?", "Pilot required?", "Procurement process?", "Security review?"] },
        { "code": "I", "name": "Identify Pain", "icon": "target-crosshair", "color": "#1e3a5f", "questions": ["Surface and root pain", "Cost, service, capacity, planning, growth, visibility, sustainability"] },
        { "code": "O", "name": "Operational Reality", "icon": "truck-fleet", "color": "#1e3a5f", "questions": ["Network, fleet, dispatch, carriers, planning cadence, constraints, last mile model"] },
        { "code": "C", "name": "Champion", "icon": "person-advocate", "color": "#1e3a5f", "questions": ["Internal advocate?", "Influence?", "Credibility?", "Alignment?"] }
      ],
      "outcome": "Qualified opportunity with clear pain, stakeholders, and process"
    },
    "level2_operational_discovery": {
      "title": "Operational Discovery Elements",
