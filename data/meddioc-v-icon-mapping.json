        { "number": 1, "name": "Network & Topology", "icon": "map-locations", "color": "#2563eb", "subtopics": ["Depots & hubs", "Territories", "Service regions", "Cross-docks", "Delivery zones"] },
        { "number": 2, "name": "Fleet & Driver Operations", "icon": "truck-driver", "color": "#2563eb", "subtopics": ["Owned vs. outsourced", "Vehicle classes", "EV mix", "HOS constraints", "Driver shortages"] },
        { "number": 3, "name": "Planning & Optimization Maturity", "icon": "gear-optimization", "color": "#2563eb", "subtopics": ["Manual vs. optimized", "Tools & AI usage", "Constraint sophistication", "Reoptimization?"] },
        { "number": 4, "name": "Order & Demand Characteristics", "icon": "package-orders", "color": "#2563eb", "subtopics": ["Order visibility", "Windows & SLAs", "Pickups & returns", "Same-day?", "Recurring demand?"] },
        { "number": 5, "name": "Cost & Performance Baseline", "icon": "chart-cost", "color": "#2563eb", "subtopics": ["Route cost", "Fuel", "Utilization", "Overtime", "Failed stops"] },
        { "number": 6, "name": "Sustainability & Regulatory", "icon": "leaf-sustainability", "color": "#2563eb", "subtopics": ["Emissions goals", "EV readiness", "ESG reporting", "HOS / compliance"] },
        { "number": 7, "name": "Technology Ecosystem", "icon": "code-api", "color": "#2563eb", "subtopics": ["ERP / TMS", "Telematics", "Execution platforms", "CRM / API readiness"] },
        { "number": 8, "name": "Last Mile / Execution Reality", "icon": "delivery-house", "color": "#2563eb", "subtopics": ["DSP usage", "Gig providers", "ETA visibility", "Proof of delivery", "Exceptions"] },
        { "number": 9, "name": "Transformation Readiness", "icon": "rocket-change", "color": "#2563eb", "subtopics": ["Exec sponsorship", "Data maturity", "IT capacity", "Change appetite", "Rollout readiness"] }
      ],
      "outcome": "Comprehensive view of operations, technology, and readiness"
    },
    "level3_value_engineering": {
      "title": "Value Engineering Layer",
      "subtitle": "Turn insights into compelling business value",
      "owner": "SE + Sales Leadership",
      "value_drivers": [
        { "name": "Economic Value", "icon": "dollar-savings", "color": "#16a34a", "examples": ["Cost reduction", "Fleet reduction", "Fuel savings", "Planning labor reduction"] },
        { "name": "Efficiency Value", "icon": "lightning-productivity", "color": "#16a34a", "examples": ["Productivity", "Automation", "Route quality", "Planner scalability"] },
        { "name": "Risk Value", "icon": "shield-protection", "color": "#16a34a", "examples": ["Compliance", "SLA protection", "Driver shortage mitigation"] },
        { "name": "Growth Value", "icon": "chart-growth", "color": "#16a34a", "examples": ["Scale expansion", "Network flexibility", "Service differentiation"] }
      ],
      "value_equation": "PAIN (Impact) + PTV CAPABILITY (Capability) = QUANTIFIED VALUE (Outcome)",
      "outcome": "Compelling business case with quantified ROI"
    }
  },
